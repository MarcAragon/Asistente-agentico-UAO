# Clave de API de Cerebras (obtener en https://cloud.cerebras.ai)
CEREBRAS_API_KEY=

# Claves adicionales de Cerebras, separadas por coma: ante un limite de
# cuota/429 (o clave invalida 401/403) el LLM rota a la siguiente.
CEREBRAS_API_KEYS=

# Clave de API de LlamaCloud (obtener en https://cloud.llamaindex.ai)
# Usada por scripts/llama_cloud_parsing.py para parsear los PDFs a markdown.
LLAMA_CLOUD_API_KEY=

# Modelo de LLM en Cerebras (catalogo: qwen-3.8-27b, gpt-oss-120b)
UAO_RAG__LLM_MODEL=qwen-3.8-27b
UAO_RAG__LLM_TEMPERATURE=0.1
UAO_RAG__LLM_MAX_TOKENS=1024
# Reintentos ante 429/timeout (backoff exponencial)
UAO_RAG__LLM_MAX_RETRIES=3
# qwen-3.8 razona por defecto y agota max_tokens en thinking (respuesta
# vacia). Desactivado para la sintesis solo-contexto.
UAO_RAG__LLM_DISABLE_REASONING=1

# gRPC: plano de control de ingesta (Fase 5). La consulta publica vive en
# la API REST (:8000); gRPC expone SOLO la administracion del indice
# (IndexAdmin: Ingest con progreso en streaming, PruneIndex, IndexStatus).
UAO_RAG__GRPC_ENABLED=1
UAO_RAG__GRPC_PORT=50051

# Rutas
UAO_RAG__DOCS_DIR=Data/Documentos
UAO_RAG__MARKDOWN_DIR=Data/Documentos_MD
UAO_RAG__CHROMA_DIR=Data/chroma

# Recuperacion
UAO_RAG__TOP_K=5
UAO_RAG__MIN_SIMILARITY=0.35

# Embeddings locales E5 (vacio = deteccion automatica: CUDA/ROCm/CPU)
# E5 requiere prefijos "query:"/"passage:" (gestionados en embeddings.py)
UAO_RAG__EMBEDDING_MODEL=intfloat/multilingual-e5-base
UAO_RAG__EMBEDDING_DEVICE=
UAO_RAG__EMBEDDING_BATCH_SIZE=16

# Chunking (Fase 2)
UAO_RAG__CHUNK_SIZE_TOKENS=400
UAO_RAG__CHUNK_MAX_TOKENS=450
UAO_RAG__CHUNK_OVERLAP_TOKENS=70
UAO_RAG__CHUNK_MIN_TOKENS=80

# Cache semantico en Redis (Fase 7). Es OPCIONAL y degradable: sin Redis (o
# con CACHE_ENABLED=0) la API responde igual, solo mas lenta. En local se
# desarrolla con fakeredis; en docker compose apunta al servicio `redis`.
UAO_RAG__REDIS_URL=redis://localhost:6379/0
UAO_RAG__CACHE_ENABLED=1
UAO_RAG__CACHE_SIMILARITY=0.97
UAO_RAG__CACHE_TTL_SECONDS=86400

# Frontend Streamlit (Fase 7): URL de la API que consume. En local es la API
# del host; dentro de docker compose se sobreescribe a http://api:8000.
UAO_RAG__API_BASE_URL=http://localhost:8000
# Panel "fue util?" (nice-to-have del doc base). 0 = oculto.
UAO_RAG__FEEDBACK_ENABLED=0

# ---------------------------------------------------------------- Despliegue
# Variables del docker compose (Fase 8). NO llevan prefijo UAO_RAG__: son
# del compose/Caddy, no de Settings.
#
# Dominio del proxy TLS. `localhost` usa la CA interna de Caddy (demo/intranet);
# con un dominio real (p. ej. asistente.uao.edu.co) Caddy emite y renueva el
# certificado por ACME. Ver docs/guia-despliegue.md.
SITE_ADDRESS=localhost
# `internal` (CA propia de Caddy) o el correo de contacto para ACME,
# p. ej. TLS_DIRECTIVE=soporte.ti@uao.edu.co
TLS_DIRECTIVE=internal
# Etiqueta de las imagenes construidas localmente.
IMAGE_TAG=0.1.0


